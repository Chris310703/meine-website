# ===========================================================
#  Life OS – lokale Konfiguration
#  Kopiere diese Datei zu ".env" und trage deine Daten ein.
#  Die .env-Datei wird NIE committet (steht in .gitignore).
# ===========================================================

# --- Garmin Connect (optional) ------------------------------
# Alternativ kannst du dich in der App unter Einstellungen → Verbindungen
# anmelden; dann wird das Passwort nicht gespeichert, nur ein Login-Token.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- Claude API von Anthropic (optional) --------------------
# Schlüssel erstellen: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modell (Standard: claude-opus-5). Günstiger: claude-sonnet-5
CLAUDE_MODEL=claude-opus-5

# --- Google Kalender (optional) -----------------------------
# Pfad zur heruntergeladenen OAuth-Datei (Standard: backend/data/google_client_secret.json)
# GOOGLE_CLIENT_SECRET_FILE=

# --- Allgemein ----------------------------------------------
# Beispieldaten beim ersten Start anlegen (1 = ja, 0 = nein)
LIFEOS_DEMO_DATA=1
# Garmin/Google beim Start automatisch synchronisieren
LIFEOS_AUTO_SYNC=1
# Zeitzone für Kalendertermine
LIFEOS_TIMEZONE=Europe/Berlin
# Port der App (http://localhost:PORT)
LIFEOS_PORT=8000
